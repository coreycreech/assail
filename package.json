{
  "name": "assail-healthcare",
  "private": true,
  "workspaces": ["client", "server"],
  "scripts": {
    "start": "concurrently \"npm run start --workspace client\" \"npm run dev --workspace server\"",
    "client": "npm run start --workspace client",
    "server": "npm run dev --workspace server",
    "build": "npm run build --workspace client"
  },
  "devDependencies": { "concurrently": "^9.1.2" }
}
